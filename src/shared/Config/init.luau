-- Config entry point (v0.2).
-- Schema and Data/* are generated by tools/stat_converter.py from the Stat Template.
-- Logic reads stats from here; balance changes are template edits, never logic edits.

local Schema = require(script.Schema)

local Data = {}
for _, tab in Schema.Tabs do
	Data[tab.Module] = require(script.Data[tab.Module])
end

return {
	Schema = Schema,
	Data = Data,
}
